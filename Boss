<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Change ta voix</title>
<style>
:root{--bg:#e8eef4;--ink:#10243a;--soft:#5b6f84;--card:#fff;--rec:#ff4d6d;--on:#0e8a8a;--line:#c9d6e2}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
main{max-width:520px;margin:0 auto;padding:28px 18px 60px}
h1{font-size:2rem;line-height:1.1;margin:0 0 6px;letter-spacing:-.02em}
.sub{color:var(--soft);margin:0 0 26px}
section{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;margin-bottom:16px}
h2{font-size:1.05rem;margin:0 0 14px}
.rec-row{display:flex;align-items:center;gap:18px}
#rec{width:84px;height:84px;border-radius:50%;border:0;background:var(--rec);color:#fff;font-size:.85rem;font-weight:700;cursor:pointer;flex:none}
#rec.live{animation:pulse 1.1s infinite}
@keyframes pulse{50%{box-shadow:0 0 0 14px rgba(255,77,109,.2)}}
@media (prefers-reduced-motion:reduce){#rec.live{animation:none;outline:4px solid rgba(255,77,109,.35)}}
.rec-row p{margin:0;color:var(--soft);font-size:.95rem}
label.file{display:inline-block;margin-top:14px;padding:10px 14px;border:1.5px dashed var(--soft);border-radius:12px;cursor:pointer;font-size:.92rem}
input[type=file]{display:none}
.fx{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.fx button{padding:14px 6px;border-radius:14px;border:1.5px solid var(--line);background:#f6f9fc;color:var(--ink);font:inherit;font-weight:600;font-size:.92rem;cursor:pointer}
.fx button[aria-pressed=true]{background:var(--on);border-color:var(--on);color:#fff}
button:focus-visible,label.file:focus-within{outline:3px solid var(--ink);outline-offset:2px}
canvas{width:100%;height:80px;display:block;margin-bottom:12px;border-radius:10px;background:#f1f5f9}
audio{width:100%}
#dl{margin-top:12px;display:none;padding:12px 16px;border-radius:12px;border:0;background:var(--ink);color:#fff;font:inherit;font-weight:600;cursor:pointer}
#msg{min-height:1.4em;margin:0 0 12px;color:var(--soft);font-size:.92rem}
#msg.err{color:#b3261e}
</style>
</head>
<body>
<main>
  <h1>Change ta voix</h1>
  <p class="sub">Enregistre-toi ou charge un son, choisis un effet, puis écoute et télécharge le résultat.</p>

  <section>
    <h2>1. Ta voix</h2>
    <div class="rec-row">
      <button id="rec" type="button">Enregistrer</button>
      <p id="recHint">Appuie pour démarrer, appuie encore pour arrêter.</p>
    </div>
    <label class="file">Ou choisir un fichier audio<input id="file" type="file" accept="audio/*"></label>
  </section>

  <section>
    <h2>2. L’effet</h2>
    <div class="fx" id="fx"></div>
  </section>

  <section>
    <h2>3. Le résultat</h2>
    <p id="msg">Enregistre ou charge un son pour commencer.</p>
    <canvas id="wave" width="600" height="160"></canvas>
    <audio id="player" controls></audio>
    <button id="dl" type="button">Télécharger en WAV</button>
  </section>
</main>

<script>
const EFFECTS = {
  grave:   {label:"Grave",   rate:0.72},
  aigu:    {label:"Aigu",    rate:1.35},
  enfant:  {label:"Enfant",  rate:1.7},
  robot:   {label:"Robot",   ring:55},
  monstre: {label:"Monstre", rate:0.55, lowpass:1800},
  echo:    {label:"Écho",    echo:true}
};
const $ = id => document.getElementById(id);
let source = null;      // AudioBuffer d'origine
let current = "grave";  // effet choisi
let mediaRec = null, chunks = [], resultBlob = null, resultUrl = null;

function say(text, err){ const m=$("msg"); m.textContent=text; m.className=err?"err":""; }

// Boutons d'effets
Object.entries(EFFECTS).forEach(([key, fx]) => {
  const b = document.createElement("button");
  b.type = "button"; b.textContent = fx.label;
  b.setAttribute("aria-pressed", key === current);
  b.onclick = () => {
    current = key;
    document.querySelectorAll("#fx button").forEach(x => x.setAttribute("aria-pressed", x === b));
    if (source) apply();
  };
  $("fx").appendChild(b);
});

// Décodage d'un fichier ou d'un enregistrement
async function load(arrayBuffer){
  try{
    say("Lecture du son…");
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    source = await ctx.decodeAudioData(arrayBuffer);
    ctx.close();
    await apply();
  }catch(e){
    source = null;
    say("Impossible de lire ce son. Essaie un autre fichier (mp3, wav, m4a).", true);
  }
}

$("file").onchange = async e => {
  const f = e.target.files[0];
  if (f) await load(await f.arrayBuffer());
};

// Enregistrement micro
$("rec").onclick = async () => {
  if (mediaRec && mediaRec.state === "recording"){ mediaRec.stop(); return; }
  if (!navigator.mediaDevices || !window.MediaRecorder){
    say("Ton navigateur ne permet pas l’enregistrement. Utilise « Choisir un fichier audio ».", true); return;
  }
  try{
    const stream = await navigator.mediaDevices.getUserMedia({audio:true});
    chunks = [];
    mediaRec = new MediaRecorder(stream);
    mediaRec.ondataavailable = e => e.data.size && chunks.push(e.data);
    mediaRec.onstop = async () => {
      stream.getTracks().forEach(t => t.stop());
      $("rec").classList.remove("live"); $("rec").textContent = "Enregistrer";
      $("recHint").textContent = "Enregistrement terminé. Tu peux en refaire un.";
      await load(await new Blob(chunks).arrayBuffer());
    };
    mediaRec.start();
    $("rec").classList.add("live"); $("rec").textContent = "Arrêter";
    $("recHint").textContent = "Enregistrement en cours…";
  }catch(e){
    say("Accès au micro refusé. Autorise le micro dans les réglages du navigateur.", true);
  }
};

// Application de l'effet
async function render(buf, fx){
  const rate = fx.rate || 1;
  const tail = fx.echo ? Math.ceil(buf.sampleRate * 1.5) : 0;
  const len = Math.ceil(buf.length / rate) + tail;
  const ctx = new OfflineAudioContext(buf.numberOfChannels, len, buf.sampleRate);
  const src = ctx.createBufferSource();
  src.buffer = buf; src.playbackRate.value = rate;
  let node = src;
  if (fx.ring){
    const g = ctx.createGain(); g.gain.value = 0;
    const o = ctx.createOscillator(); o.frequency.value = fx.ring; o.connect(g.gain); o.start();
    node.connect(g); node = g;
  }
  if (fx.lowpass){
    const f = ctx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = fx.lowpass;
    node.connect(f); node = f;
  }
  if (fx.echo){
    const d = ctx.createDelay(1); d.delayTime.value = 0.28;
    const fb = ctx.createGain(); fb.gain.value = 0.4;
    node.connect(d); d.connect(fb); fb.connect(d); d.connect(ctx.destination);
  }
  node.connect(ctx.destination);
  src.start();
  return ctx.startRendering();
}

async function apply(){
  try{
    say("Application de l’effet…");
    const out = await render(source, EFFECTS[current]);
    resultBlob = toWav(out);
    if (resultUrl) URL.revokeObjectURL(resultUrl);
    resultUrl = URL.createObjectURL(resultBlob);
    $("player").src = resultUrl;
    $("dl").style.display = "inline-block";
    drawWave(out);
    say("Effet « " + EFFECTS[current].label + " » appliqué. Appuie sur lecture.");
  }catch(e){
    say("L’effet n’a pas pu être appliqué. Réessaie avec un son plus court.", true);
  }
}

// Courbe du son
function drawWave(buf){
  const c = $("wave"), g = c.getContext("2d"), d = buf.getChannelData(0);
  g.clearRect(0,0,c.width,c.height);
  g.fillStyle = "#0e8a8a";
  const step = Math.ceil(d.length / c.width);
  for (let x = 0; x < c.width; x++){
    let max = 0;
    for (let i = 0; i < step; i++) max = Math.max(max, Math.abs(d[x*step+i] || 0));
    const h = Math.max(2, max * c.height * 0.9);
    g.fillRect(x, (c.height - h) / 2, 1, h);
  }
}

// Export WAV 16 bits
function toWav(buf){
  const ch = buf.numberOfChannels, n = buf.length, rate = buf.sampleRate;
  const data = new DataView(new ArrayBuffer(44 + n * ch * 2));
  const w = (o, s) => [...s].forEach((c, i) => data.setUint8(o + i, c.charCodeAt(0)));
  w(0,"RIFF"); data.setUint32(4, 36 + n*ch*2, true); w(8,"WAVEfmt ");
  data.setUint32(16,16,true); data.setUint16(20,1,true); data.setUint16(22,ch,true);
  data.setUint32(24,rate,true); data.setUint32(28,rate*ch*2,true);
  data.setUint16(32,ch*2,true); data.setUint16(34,16,true);
  w(36,"data"); data.setUint32(40, n*ch*2, true);
  let o = 44;
  for (let i = 0; i < n; i++)
    for (let c = 0; c < ch; c++){
      const s = Math.max(-1, Math.min(1, buf.getChannelData(c)[i]));
      data.setInt16(o, s < 0 ? s * 0x8000 : s * 0x7fff, true); o += 2;
    }
  return new Blob([data], {type:"audio/wav"});
}

$("dl").onclick = () => {
  const a = document.createElement("a");
  a.href = resultUrl; a.download = "ma-voix-" + current + ".wav"; a.click();
};
</script>
</body>
</html>
